APP_NAME=XBoard
APP_ENV=local
APP_KEY=base64:PZXk5vTuTinfeEVG5FpYv2l6WEhLsyvGpiWK7IgJJ60=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack

# Client IP detection behind proxies (optional)
# Comma/space separated proxy IPs/CIDRs that are allowed to set X-Forwarded-* headers.
# Example: XBOARD_TRUSTED_PROXIES=1.2.3.4,5.6.7.0/24
# XBOARD_TRUSTED_PROXIES=
#
# If your proxy egress IP changes frequently, configure a shared secret.
# When the request contains this header, Xboard will trust X-Forwarded-* for that request.
# XBOARD_PROXY_SECRET=
# XBOARD_PROXY_SECRET_HEADER=X-Xboard-Proxy-Secret
#
# Optional: reuse "server_token" (node communication token) as proxy secret
# XBOARD_PROXY_SECRET_FROM_SERVER_TOKEN=false

# Risk center (optional)
# Exclude IPs from risk aggregation (exact IPs only, comma/space separated)
# Example: XBOARD_RISK_EXCLUDE_IPS=1.2.3.4,5.6.7.8
# XBOARD_RISK_EXCLUDE_IPS=
# Exclude node IPs (v2_server.host that are IPs) from risk aggregation
# XBOARD_RISK_EXCLUDE_NODE_IPS=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xboard
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Optional: separate Redis instance for cache
# REDIS_CACHE_HOST=127.0.0.1
# REDIS_CACHE_PASSWORD=null
# REDIS_CACHE_PORT=6379
# REDIS_CACHE_DB=1

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Cache store redis connection: default|cache
CACHE_REDIS_CONNECTION=default

# Node API cache (0 disables)
SERVER_API_CACHE_STORE=redis-cache
SERVER_API_USER_CACHE_TTL=30
SERVER_API_CONFIG_CACHE_TTL=10
SERVER_API_CACHE_LOCK_TTL=10
SERVER_API_CACHE_LOCK_WAIT=3

# Prefer reading available node users from user_sync_states (precomputed table)
# Set to false for emergency rollback to legacy v2_user query.
USER_SYNC_USE_STATE_TABLE_FOR_SERVER_USERS=true

# Prefer UNION-based index-friendly query for /server/user_delta
# Set to false for emergency rollback to legacy OR query.
USER_SYNC_USE_UNION_QUERY_FOR_DELTA=true

# user_sync_events cleanup tuning
USER_SYNC_CLEANUP_BATCH_SIZE=5000
USER_SYNC_CLEANUP_SLEEP_MS=0

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=null
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# google cloud storage
ENABLE_AUTO_BACKUP_AND_UPDATE=false
GOOGLE_CLOUD_KEY_FILE=config/googleCloudStorageKey.json
GOOGLE_CLOUD_STORAGE_BUCKET=

# Prevent reinstallation
INSTALLED=false

# Ticket attachments (local storage + webp)
# Attachment preview links are signed absolute URLs. In production, set
# APP_URL to the public HTTPS origin and configure XBOARD_TRUSTED_PROXIES so
# X-Forwarded-Proto/Host from your reverse proxy are trusted.
# TICKET_RETENTION_DAYS=90
# TICKET_ATTACHMENTS_DISK=local
# TICKET_ATTACHMENTS_DIR=ticket_attachments
# TICKET_ATTACHMENTS_MAX_IMAGES=3
# TICKET_ATTACHMENTS_MAX_KB=5120
# TICKET_ATTACHMENTS_MAX_DIMENSION=1920
# TICKET_ATTACHMENTS_WEBP_QUALITY=80
