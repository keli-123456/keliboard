[Unit]
Description=Keliboard manual failover worker (standalone)
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
User=keliboard-failover
Group=keliboard-failover
WorkingDirectory=/opt/keliboard-failover/current
EnvironmentFile=/etc/keliboard-failover/operator.env
ExecStart=/usr/bin/php -d memory_limit=160M artisan machines:work-operator-failover
CPUQuota=25%
MemoryMax=192M
TasksMax=8
RuntimeMaxSec=17min
TimeoutStopSec=85s
Restart=always
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/keliboard-failover/current/storage
UMask=0077
